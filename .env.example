# Copie para .env e adicione sua chave gratuita: https://www.pexels.com/api/
PEXELS_API_KEY=

# Opcional: somente números, com DDI e DDD. Ex.: 5511999999999
WHATSAPP_NUMBER=

# Opcional: e-mail que receberá os pedidos de orçamento.
CONTACT_EMAIL=

PORT=3100

# A ViaCEP usada no checkout não exige chave.

# Supabase: banco de pedidos e armazenamento privado das artes.
# O .env local preserva os nomes anteriores e reaproveita as credenciais ja configuradas.
SUPABASE_URL=
# PRIVADA: apenas no backend. Nunca usar prefixo NEXT_PUBLIC_ ou VITE_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=
# Publica, preferida para acesso sujeito a RLS. Compatibilidade legada em ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Mercado Pago Checkout Pro: preencher com as credenciais da mesma aplicacao.
# test ou production: usar credenciais correspondentes ao ambiente.
# ENVIRONMENT e uma configuracao da loja; nao converte credenciais de producao em teste.
MERCADO_PAGO_ENVIRONMENT=test
# PRIVADA: Access Token do painel Suas integracoes > aplicacao > Credenciais.
MERCADO_PAGO_ACCESS_TOKEN=
# Publica. Opcional no redirecionamento direto; reservada para o SDK frontend.
MERCADO_PAGO_PUBLIC_KEY=
# PRIVADA: chave de assinatura gerada em Webhooks > Configurar notificacao.
MERCADO_PAGO_WEBHOOK_SECRET=
# Legada: a integracao deriva a URL de APP_URL + /api/webhooks/mercado-pago.
MERCADO_PAGO_WEBHOOK_URL=

# URL HTTPS publica da Vercel; depois pode ser substituida pelo dominio definitivo.
# As URLs de retorno ao checkout serao derivadas de APP_URL.
APP_URL=
# PRIVADA: segredo aleatorio da sessao sem cadastro; o .env local ja recebeu um valor gerado.
# Usar segredos diferentes em desenvolvimento, Preview e Production.
GUEST_SESSION_SECRET=
# Nome do bucket privado criado por npm run checkout:setup.
ARTWORK_STORAGE_BUCKET=artworks
# Manter false ate precos, entrega, dominio e pagamento de teste serem validados.
CHECKOUT_ENABLED=false

# Painel administrativo: habilitar somente no computador local.
# A rota recusa rede externa, proxies, Vercel e NODE_ENV=production.
CATALOG_ADMIN_ENABLED=false

# Preencher as variaveis nao basta: o checkout verifica tambem schema, ofertas e ambiente.
# Tokens administrativos do Supabase/Vercel e credenciais diretas do banco nao sao
# necessarios ao checkout e nao devem ser enviados ao navegador.

# Produção UP / Next.js. Use HTTPS e a origem exata no ambiente publicado.
PRODUCTION_ENABLED=true
# true abre o painel na raiz da implantação dedicada; false mantém a loja na raiz.
PRODUCTION_ONLY=false
# Na Vercel, deixe vazia para derivar das variáveis de sistema.
# Ao conectar domínio próprio, configure a origem HTTPS exata e faça novo deploy.
PRODUCTION_ORIGIN=http://localhost:3101
# PRIVADO: gere ao menos 32 caracteres aleatórios; não reutilize entre ambientes.
PRODUCTION_SESSION_SECRET=
PRODUCTION_BUCKET=production-up
# Reutiliza a conexão existente; chave apenas no servidor.
AI_GATEWAY_API_KEY=
# ID exato do catálogo https://ai-gateway.vercel.sh/v1/models (com tool-use).
PRODUCTION_AI_MODEL=
# Somente para aplicar migrações, fora do navegador e do conector.
SUPABASE_ACCESS_TOKEN=
